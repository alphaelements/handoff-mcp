// ============================================================================
// handoff-mcp PDF template: report.typ  (reports)
//
// Generated by handoff-mcp into `.handoff/templates/`; never overwritten once
// it exists. Differences from default.typ: serif body text, an organization
// line on the cover, and every top-level heading starts a new page.
//
// The cover, table of contents, header and footer are imported from
// default.typ, so editing those there changes every template. To give the
// report its own, define a function of the same name below instead of
// importing it.
// ============================================================================

#import "default.typ": as-array, default-font-mono, default-font-sans, default-font-serif, page-footer, page-header, toc-page

// The bundle cover's numbered document list. Defined here, not imported from
// default.typ, so this template still compiles beside an older default.typ.
#let document-list(documents) = if documents != none and documents.len() > 0 {
  v(2.5em)
  set text(size: 10.5pt)
  align(center, stack(dir: ttb, spacing: 0.6em, ..documents.enumerate().map(((i, d)) => [#(i + 1). #d])))
}

#let report-cover(
  title: none,
  subtitle: none,
  author: none,
  date: none,
  organization: none,
  doc-id: none,
  version: none,
  status: none,
  documents: none,
) = page(
  margin: (x: 2.5cm, y: 3cm),
  header: none,
  footer: none,
)[
  #align(center + horizon)[
    #if organization != none [
      #text(size: 13pt, tracking: 0.1em)[#organization]
      #v(3em)
    ]
    #line(length: 60%, stroke: 1pt)
    #v(1em)
    #text(size: 26pt, weight: "bold")[#title]
    #if subtitle != none [
      #v(0.8em)
      #text(size: 14pt)[#subtitle]
    ]
    #v(1em)
    #line(length: 60%, stroke: 1pt)
    #v(3em)
    #if author != none [
      #text(size: 13pt)[#author] \
    ]
    #if date != none [
      #text(size: 12pt)[#date] \
    ]
    #if doc-id != none or version != none or status != none [
      #v(2em)
      #set text(size: 10pt, fill: luma(90))
      #(
        (
          if doc-id != none { [ID: #doc-id] },
          if version != none { [Version: #version] },
          if status != none { [Status: #status] },
        )
          .filter(x => x != none)
          .join([ #sym.bullet ])
      )
    ]
    #document-list(documents)
  ]
]

#let conf(
  title: "Untitled",
  subtitle: none,
  author: none,
  date: none,
  organization: none,
  doc-id: none,
  version: none,
  status: none,
  documents: none,
  lang: "ja",
  paper: "a4",
  font-sans: default-font-sans,
  font-serif: default-font-serif,
  font-mono: default-font-mono,
  show-cover: true,
  show-toc: true,
  toc-depth: 3,
  doc,
) = {
  let date = if date == none { datetime.today().display("[year]-[month]-[day]") } else { date }
  let sans = as-array(font-sans)
  let serif = as-array(font-serif)
  let mono = as-array(font-mono) + sans

  set document(title: title, author: if author == none { () } else { author })

  set page(
    paper: paper,
    margin: (x: 2.4cm, top: 3cm, bottom: 2.6cm),
    header: page-header(title: title, date: date),
    footer: page-footer(),
  )

  // Body text is serif; headings stay sans.
  set text(lang: lang, font: serif, size: 10.5pt)
  set par(justify: true, leading: 0.85em, spacing: 1.1em)

  set heading(numbering: "1.1")
  show heading: set text(font: sans, weight: "bold")
  show heading: set block(above: 1.5em, below: 0.9em)
  show heading.where(level: 1): set text(size: 20pt)
  show heading.where(level: 2): set text(size: 15pt)
  show heading.where(level: 3): set text(size: 12pt)
  show heading.where(level: 1): it => {
    pagebreak(weak: true)
    it
  }

  show raw: set text(font: mono, size: 0.9em)
  show raw.where(block: true): block.with(width: 100%, fill: luma(245), inset: 8pt, radius: 3pt)
  show link: set text(fill: rgb("#1a5fb4"))
  set table(stroke: 0.5pt + luma(170), inset: 6pt)

  if show-cover {
    report-cover(
      title: title,
      subtitle: subtitle,
      author: author,
      date: date,
      organization: organization,
      doc-id: doc-id,
      version: version,
      status: status,
      documents: documents,
    )
    counter(page).update(1)
  }
  if show-toc {
    toc-page(title: if lang == "ja" { "目次" } else { "Contents" }, depth: toc-depth)
  }

  doc
}
