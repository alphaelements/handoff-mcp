// ============================================================================
// handoff-mcp PDF template: default.typ  (general purpose)
//
// This file was generated by handoff-mcp into `.handoff/templates/`.
// It is YOUR file: handoff-mcp never overwrites it once it exists. Edit it
// freely (or delete it to get a fresh copy on the next export).
//
// How it is used
//   handoff-mcp generates `.handoff/exports/<slug>.typ` from the Markdown
//   document. That file starts with
//
//       #import "/.handoff/templates/default.typ": conf
//       #show: conf.with(title: "...", author: "...", date: "...", ...)
//
//   followed by the converted body. Everything about page layout therefore
//   lives here, never in the generated file.
//
// Structure (each section is a separate function so you can override one
// without touching the others; `report.typ` and `spec.typ` re-use them):
//   - cover-page   title / subtitle / author / date
//   - toc-page     automatic table of contents
//   - page-header  running header (title + date)
//   - page-footer  page number
//   - conf         assembles the above and defines text / heading / code /
//                  table styles via #set and #show rules
// ============================================================================

// Font candidates, in preference order. handoff-mcp detects the installed
// families (`typst fonts`) and passes the ones it found as `font-sans` /
// `font-serif`; these lists are only the fallback when this template is
// compiled by hand.
#let default-font-sans = ("Noto Sans CJK JP", "IPAexGothic", "IPAGothic", "Hiragino Sans", "Yu Gothic")
#let default-font-serif = ("Noto Serif CJK JP", "IPAexMincho", "IPAMincho", "Hiragino Mincho ProN", "Yu Mincho")
#let default-font-mono = ("DejaVu Sans Mono",)

// Accept either a single family name or an array of names.
#let as-array(x) = if type(x) == array { x } else { (x,) }

// --- Cover ------------------------------------------------------------------
#let cover-page(title: none, subtitle: none, author: none, date: none) = page(
  margin: (x: 2.5cm, y: 3cm),
  header: none,
  footer: none,
)[
  #align(center + horizon)[
    #text(size: 26pt, weight: "bold")[#title]
    #if subtitle != none [
      #v(0.8em)
      #text(size: 14pt)[#subtitle]
    ]
    #v(4em)
    #if author != none [
      #text(size: 13pt)[#author] \
    ]
    #if date != none [
      #text(size: 12pt)[#date]
    ]
  ]
]

// --- Table of contents ------------------------------------------------------
#let toc-page(title: "Contents", depth: 3) = {
  outline(title: title, depth: depth, indent: auto)
  pagebreak()
}

// --- Running header / footer -------------------------------------------------
#let page-header(title: none, date: none) = {
  set text(size: 9pt, fill: luma(90))
  grid(columns: (1fr, auto), align: (left, right), [#title], [#date])
  line(length: 100%, stroke: 0.5pt + luma(160))
}

#let page-footer() = {
  set text(size: 9pt, fill: luma(90))
  align(center, context counter(page).display("1"))
}

// --- Document entry point ----------------------------------------------------
#let conf(
  title: "Untitled",
  subtitle: none,
  author: none,
  date: none,
  lang: "ja",
  paper: "a4",
  font-sans: default-font-sans,
  font-serif: default-font-serif,
  font-mono: default-font-mono,
  show-cover: true,
  show-toc: true,
  toc-depth: 3,
  doc,
) = {
  let date = if date == none { datetime.today().display("[year]-[month]-[day]") } else { date }
  let sans = as-array(font-sans)
  let serif = as-array(font-serif)
  let mono = as-array(font-mono) + sans

  // Document metadata.
  set document(title: title, author: if author == none { () } else { author })

  // Page: body pages get the running header and the page number.
  set page(
    paper: paper,
    margin: (x: 2.2cm, top: 2.8cm, bottom: 2.5cm),
    header: page-header(title: title, date: date),
    footer: page-footer(),
  )

  // Text and paragraphs.
  set text(lang: lang, font: sans, size: 10.5pt)
  set par(justify: true, leading: 0.75em, spacing: 1em)

  // Headings.
  set heading(numbering: "1.1")
  show heading: set text(font: sans, weight: "bold")
  show heading: set block(above: 1.4em, below: 0.8em)
  show heading.where(level: 1): set text(size: 18pt)
  show heading.where(level: 2): set text(size: 14pt)
  show heading.where(level: 3): set text(size: 12pt)

  // Code, links, tables.
  show raw: set text(font: mono, size: 0.9em)
  show raw.where(block: true): block.with(width: 100%, fill: luma(245), inset: 8pt, radius: 3pt)
  show link: set text(fill: rgb("#1a5fb4"))
  set table(stroke: 0.5pt + luma(170), inset: 6pt)

  // Front matter.
  if show-cover {
    cover-page(title: title, subtitle: subtitle, author: author, date: date)
    counter(page).update(1)
  }
  if show-toc {
    toc-page(title: if lang == "ja" { "目次" } else { "Contents" }, depth: toc-depth)
  }

  doc
}
