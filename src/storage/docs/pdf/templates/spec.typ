// ============================================================================
// handoff-mcp PDF template: spec.typ  (specifications)
//
// Generated by handoff-mcp into `.handoff/templates/`; never overwritten once
// it exists. Differences from default.typ: the cover carries a document-info
// table (document id / version / status), headings are numbered down to level
// 4, and table header rows are shaded.
//
// The table of contents, header and footer are imported from default.typ; to
// give the spec its own, define a function of the same name below instead of
// importing it.
// ============================================================================

#import "default.typ": as-array, default-font-mono, default-font-sans, default-font-serif, page-footer, page-header, toc-page

#let spec-cover(title: none, subtitle: none, author: none, date: none, doc-id: none, version: none, status: none) = {
  let rows = ()
  if doc-id != none { rows += (strong("Document ID"), doc-id) }
  if version != none { rows += (strong("Version"), version) }
  if status != none { rows += (strong("Status"), status) }
  if author != none { rows += (strong("Author"), author) }
  if date != none { rows += (strong("Date"), date) }

  page(
    margin: (x: 2.5cm, y: 3cm),
    header: none,
    footer: none,
  )[
    #align(center + horizon)[
      #text(size: 26pt, weight: "bold")[#title]
      #if subtitle != none [
        #v(0.8em)
        #text(size: 14pt)[#subtitle]
      ]
      #if rows.len() > 0 [
        #v(3em)
        #table(columns: (auto, auto), stroke: none, fill: none, align: left, inset: 5pt, ..rows)
      ]
    ]
  ]
}

#let conf(
  title: "Untitled",
  subtitle: none,
  author: none,
  date: none,
  doc-id: none,
  version: none,
  status: none,
  lang: "ja",
  paper: "a4",
  font-sans: default-font-sans,
  font-serif: default-font-serif,
  font-mono: default-font-mono,
  show-cover: true,
  show-toc: true,
  toc-depth: 4,
  doc,
) = {
  let date = if date == none { datetime.today().display("[year]-[month]-[day]") } else { date }
  let sans = as-array(font-sans)
  let mono = as-array(font-mono) + sans

  set document(title: title, author: if author == none { () } else { author })

  set page(
    paper: paper,
    margin: (x: 2.2cm, top: 2.8cm, bottom: 2.5cm),
    header: page-header(title: title, date: date),
    footer: page-footer(),
  )

  set text(lang: lang, font: sans, size: 10pt)
  set par(justify: true, leading: 0.7em, spacing: 0.9em)

  set heading(numbering: "1.1.1.1")
  show heading: set text(font: sans, weight: "bold")
  show heading: set block(above: 1.3em, below: 0.7em)
  show heading.where(level: 1): set text(size: 17pt)
  show heading.where(level: 2): set text(size: 13pt)
  show heading.where(level: 3): set text(size: 11pt)

  show raw: set text(font: mono, size: 0.9em)
  show raw.where(block: true): block.with(width: 100%, fill: luma(245), inset: 8pt, radius: 3pt)
  show link: set text(fill: rgb("#1a5fb4"))
  set table(
    stroke: 0.5pt + luma(170),
    inset: 6pt,
    fill: (_, row) => if row == 0 { luma(235) } else { none },
  )

  if show-cover {
    spec-cover(title: title, subtitle: subtitle, author: author, date: date, doc-id: doc-id, version: version, status: status)
    counter(page).update(1)
  }
  if show-toc {
    toc-page(title: if lang == "ja" { "目次" } else { "Contents" }, depth: toc-depth)
  }

  doc
}
