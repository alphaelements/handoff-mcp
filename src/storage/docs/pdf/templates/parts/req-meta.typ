// ============================================================================
// handoff-mcp PDF template part: req-meta.typ  (requirement meta blocks)
//
// Generated by handoff-mcp into `.handoff/templates/parts/`. It is YOUR file:
// handoff-mcp never overwrites it once it exists (delete it to get a fresh
// copy on the next export).
//
// It is imported by the generated `.handoff/exports/<slug>.typ` itself, not by
// the page template, so it works with every template (built-in, customised or
// selected by path) and needs no change to them.
// ============================================================================

// --- Requirement meta block (REQ-PDF-030) -----------------------------------
// Drawn under the heading of a requirement item when the export is enriched
// (`handoff_doc_export` with `enrich: true`, the default). handoff-mcp calls it
// from the generated file:
//
//     #req-meta(priority: "P0", dev-stage: "implemented",
//       horizontal: (state: "partial", done: (1, 3)), vertical: (state: "covered"),
//       refines: ((id: "REQ-001", title: "..."),), verifies: (...),
//       tasks: ((id: "t1", title: "...", status: "done"),),
//       acceptance: ((label: "AC1", text: "...", checked: true),))
//
// Every argument is optional. Edit the colours and labels freely; keep the
// function name and argument names, they are part of the contract.
#let tr(ja, en) = context if text.lang == "ja" { ja } else { en }

#let priority-colors = (
  P0: rgb("#c01c28"),
  P1: rgb("#e66100"),
  P2: rgb("#1a5fb4"),
  P3: rgb("#77767b"),
)
#let stage-colors = (
  not_started: rgb("#77767b"),
  in_progress: rgb("#c64600"),
  implemented: rgb("#1a5fb4"),
  tested: rgb("#1b8a8f"),
  verified: rgb("#26a269"),
)
#let coverage-colors = (
  covered: rgb("#26a269"),
  partial: rgb("#e5a50a"),
  uncovered: rgb("#c01c28"),
  waived: rgb("#77767b"),
  na: rgb("#77767b"),
)
#let coverage-labels = (
  covered: tr("充足", "covered"),
  partial: tr("一部", "partial"),
  uncovered: tr("未充足", "uncovered"),
  waived: tr("免除", "waived"),
  na: tr("対象外", "n/a"),
)

#let meta-badge(label, color) = box(
  fill: color,
  inset: (x: 5pt, y: 2.5pt),
  radius: 3pt,
  baseline: 2pt,
  text(size: 8pt, weight: "bold", fill: white)[#label],
)

// A labelled bar. `coverage` is (state: "covered" | "partial" | "uncovered" |
// "waived" | "na", done: (n, total)); `done` turns a partial bar into the real
// ratio, otherwise partial is drawn half full.
#let coverage-bar(label, coverage) = {
  let state = coverage.state
  let done = coverage.at("done", default: none)
  let ratio = if done != none and done.at(1) > 0 {
    done.at(0) / done.at(1)
  } else if state == "covered" {
    1.0
  } else if state == "partial" {
    0.5
  } else {
    0.0
  }
  let color = coverage-colors.at(state, default: luma(140))
  let caption = if done != none { [#done.at(0)/#done.at(1)] } else { coverage-labels.at(state, default: state) }
  let bar-width = 2.6cm
  box(
    stack(
      dir: ltr,
      spacing: 5pt,
      box(width: 1.7cm, text(size: 8pt)[#label]),
      box(
        width: bar-width,
        height: 6pt,
        radius: 3pt,
        fill: luma(220),
        clip: true,
        rect(width: bar-width * ratio, height: 100%, fill: color, stroke: none),
      ),
      box(width: 1.2cm, text(size: 8pt, fill: color, weight: "bold")[#caption]),
    ),
  )
}

#let meta-line(label, body) = grid(
  columns: (2.2cm, 1fr),
  column-gutter: 6pt,
  text(size: 8.5pt, weight: "bold", fill: luma(90))[#label],
  body,
)

#let link-entry(entry) = [
  #text(weight: "bold")[#entry.id]#if entry.at("title", default: none) != none [ #sym.dash.en #entry.title]
]

#let task-entry(task) = [
  #text(weight: "bold")[#task.id]#if task.at("title", default: none) != none [ #task.title]#if task.at("status", default: none) != none [ #h(3pt)#meta-badge(task.status, luma(120))]
]

#let acceptance-entry(item) = {
  let mark = if item.checked { text(fill: rgb("#26a269"), weight: "bold")[✓] } else { text(fill: luma(130))[○] }
  grid(
    columns: (1.1em, 1fr),
    mark,
    [#if item.at("label", default: none) != none [#text(weight: "bold")[#item.label] ]#item.text],
  )
}

#let req-meta(
  priority: none,
  dev-stage: none,
  horizontal: none,
  vertical: none,
  refines: (),
  verifies: (),
  tasks: (),
  acceptance: (),
) = block(
  width: 100%,
  fill: luma(247),
  stroke: (left: 2pt + luma(170)),
  inset: (x: 9pt, y: 7pt),
  radius: (right: 3pt),
  above: 0.6em,
  below: 1em,
)[
  #set text(size: 9pt)
  #set par(justify: false, leading: 0.55em, spacing: 0.55em)
  #let rows = ()
  #if priority != none or dev-stage != none {
    rows.push(
      [
        #if priority != none { meta-badge(priority, priority-colors.at(priority, default: luma(120))) }
        #if dev-stage != none {
          h(4pt)
          meta-badge(dev-stage.replace("_", " "), stage-colors.at(dev-stage, default: luma(120)))
        }
      ],
    )
  }
  #if horizontal != none or vertical != none {
    rows.push(
      [
        #if horizontal != none { coverage-bar(tr("水平", "Horizontal"), horizontal) }
        #if horizontal != none and vertical != none { h(1.2em) }
        #if vertical != none { coverage-bar(tr("垂直", "Vertical"), vertical) }
      ],
    )
  }
  #if refines.len() > 0 {
    rows.push(meta-line(tr("詳細化元", "Refines"), stack(dir: ttb, spacing: 0.35em, ..refines.map(link-entry))))
  }
  #if verifies.len() > 0 {
    rows.push(meta-line(tr("検証対象", "Verifies"), stack(dir: ttb, spacing: 0.35em, ..verifies.map(link-entry))))
  }
  #if tasks.len() > 0 {
    rows.push(meta-line(tr("実装タスク", "Tasks"), stack(dir: ttb, spacing: 0.35em, ..tasks.map(task-entry))))
  }
  #if acceptance.len() > 0 {
    rows.push(meta-line(tr("受入基準", "Acceptance"), stack(dir: ttb, spacing: 0.4em, ..acceptance.map(acceptance-entry))))
  }
  #stack(dir: ttb, spacing: 0.6em, ..rows)
]
