  "//optionalDependencies": "Prebuilt binaries, one per platform. Pinned to an exact version (never ^ or ~): a wrapper must never pair with a platform package built from different sources. npm skips the entries whose os/cpu do not match instead of failing, which is what makes this work.",
  "optionalDependencies": {
    "handoff-mcp-server-darwin-arm64": "0.30.0",
    "handoff-mcp-server-darwin-x64": "0.30.0",
    "handoff-mcp-server-linux-arm64": "0.30.0",
    "handoff-mcp-server-linux-x64": "0.30.0",
    "handoff-mcp-server-win32-arm64": "0.30.0",
    "handoff-mcp-server-win32-x64": "0.30.0"
  },
  "files": [
    "bin/handoff-mcp.js",
    "bin/resolve-binary.js",
    "skills/",
    "LICENSE",
    "README.md"
  ],
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "engines": {
    "node": ">=16"
  }
}
